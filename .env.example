# Copy to .env and adjust. All processing stays local by default.

# SQLite database path (relative to project root unless absolute)
MAT_DB_PATH=data/tracker.db

# Log file
MAT_LOG_PATH=data/logs/app.log
MAT_LOG_LEVEL=INFO

# Pose detection defaults
MAT_MIN_DETECTION_CONFIDENCE=0.5
MAT_MIN_TRACKING_CONFIDENCE=0.5
MAT_MIN_VISIBILITY=0.5

# Live capture
MAT_CAMERA_INDEX=0
MAT_FRAME_WIDTH=640
MAT_TARGET_FPS=30

# Optional MediaPipe Tasks model (used only if solutions API is unavailable)
MAT_POSE_MODEL_PATH=data/models/pose_landmarker_lite.task
